local function createButton(parent, text)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(0.96, 0, 0, 32)
    btn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
    btn.Font = Enum.Font.SourceSansBold
