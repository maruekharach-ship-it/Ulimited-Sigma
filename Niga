local function isPartVisible(part)
    if not wallCheckEnabled then return true end
    local char = LocalPlayer.Character
    if not char then return false end
    
    local rayParam = RaycastParams.new()
    rayParam.FilterType = Enum.RaycastFilterType.Exclude
    rayParam.FilterDescendantsInstances = {char, Camera}
    
    local rayResult = workspace:Raycast(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position), rayParam)
    return rayResult and rayResult.Instance and rayResult.Instance:IsDescendantOf(part.Parent)
end

